# ImageDB Environment Configuration

# Database
DATABASE_URL=postgresql+asyncpg://imagedb:imagedb@localhost:5432/imagedb

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (generate a strong secret for production)
JWT_SECRET=change-me-to-a-random-string

# File Storage
STORAGE_PATH=./data/images
THUMBNAIL_PATH=./data/thumbnails

# VLM Provider: ollama | qwen_api | none
VLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3-vl:8b

# Qwen API (DashScope) - only needed if VLM_PROVIDER=qwen_api
QWEN_API_KEY=
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-max

# AI Features (true/false)
ENABLE_CLASSIFICATION=true
ENABLE_OBJECT_DETECTION=true
ENABLE_FACE_RECOGNITION=true
ENABLE_VLM_CAPTION=true

# CLIP Model
CLIP_MODEL=ViT-L/14

# Debug
DEBUG=true
